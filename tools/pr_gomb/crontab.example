# pr_gomb — the two cron lines. ALWAYS through a file (valaszok.jsonl), never a pipe; both under flock, every minute.
# The directory depends on where you cloned: here /opt/agent-bus/tools/pr_gomb — rewrite it to your own.

# 1) fetching the button replies (callback_query -> valaszok.jsonl). IF YOU ALREADY HAVE your own Telegram poller with the same
#    bot token, do NOT run THIS one (shared getUpdates offset) — see the README section "Existing poller".
* * * * * flock -n /opt/agent-bus/tools/pr_gomb/.poll.lock /usr/bin/python3 /opt/agent-bus/tools/pr_gomb/telegram_gomb_poll.py >> /opt/agent-bus/tools/pr_gomb/poll.log 2>&1

# 2) executing the decisions (merge / NO / "did not run, because…")
* * * * * flock -n /opt/agent-bus/tools/pr_gomb/.lock /usr/bin/python3 /opt/agent-bus/tools/pr_gomb/pr_gomb.py feldolgoz >> /opt/agent-bus/tools/pr_gomb/pr_gomb.log 2>&1
